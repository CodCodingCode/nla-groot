coverage.xml
*.cover

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- ML artifacts (large / generated) ---
checkpoints/**
# Re-include checkpoint *config.json* metadata (small, citable) while keeping
# weights ignored via the global *.safetensors/*.bin/*.pt patterns below.
!checkpoints/**/
!checkpoints/**/config.json
data/
# Website snapshot is committed (source of truth for the static site).
!website/src/data/
!website/src/data/snapshot.json
logs/
runs/
wandb/
mlruns/
outputs/
.hf_cache/
hf_cache/
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.h5
*.tfevents.*

# --- Third-party vendored code (cloned separately) ---
third_party/

# --- LaTeX build artifacts (paper/ — keep .tex/.bib/.pdf, ignore generated) ---
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
paper/main.out
paper/main.docx

# --- Claude Code runtime (local state, not source) ---
.claude/*.lock
.claude/scheduled_tasks.lock

# --- Misc ---
*.log
*.tmp
*.bak
.cache/
